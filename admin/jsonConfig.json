{
  "i18n": true,
  "type": "panel",
  "items": {
    "_supportedDevicesNote": {
      "type": "staticText",
      "text": "supported_devices_note",
      "style": { "fontWeight": "bold" },
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part1Headline": {
      "type": "header",
      "text": "part1_headline",
      "size": 4,
      "hidden": "data.aasToken",
      "newLine": true
    },
    "_part1Intro": {
      "type": "staticText",
      "text": "part1_intro",
      "hidden": "data.aasToken",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part1Step1": {
      "type": "staticText",
      "text": "part1_step1",
      "hidden": "data.aasToken",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part1Step1Note": {
      "type": "staticText",
      "text": "part1_step1_note",
      "style": { "color": "#e53935", "fontWeight": "bold" },
      "hidden": "data.aasToken",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part1Open": {
      "type": "staticLink",
      "href": "https://accounts.google.com/EmbeddedSetup",
      "text": "part1_open_button",
      "button": true,
      "variant": "contained",
      "hidden": "data.aasToken",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "_part1Step2": {
      "type": "staticText",
      "text": "part1_step2",
      "hidden": "data.aasToken",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part1TimeWarning": {
      "type": "staticText",
      "text": "part1_time_warning",
      "style": { "color": "orange", "fontWeight": "bold" },
      "hidden": "data.aasToken",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part1Step3": {
      "type": "staticText",
      "text": "part1_step3",
      "hidden": "data.aasToken",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part1Step4": {
      "type": "staticText",
      "text": "part1_step4",
      "hidden": "data.aasToken",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part1Image": {
      "type": "staticImage",
      "src": "img/step1-oauth-token.png",
      "showInDialog": true,
      "showInDialogSmallSize": 140,
      "hidden": "data.aasToken",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part1Step5": {
      "type": "staticText",
      "text": "part1_step5",
      "hidden": "data.aasToken",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "oauthToken": {
      "type": "text",
      "label": "oauth_token_label",
      "help": "oauth_token_help",
      "hidden": "data.aasToken",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 8,
      "lg": 6,
      "xl": 6
    },
    "_connectButton": {
      "type": "sendTo",
      "command": "connectAccount",
      "label": "connect_button",
      "jsonData": "${JSON.stringify({ token: data.oauthToken || '' })}",
      "useNative": true,
      "showProcess": true,
      "variant": "contained",
      "disabled": "!data.oauthToken",
      "hidden": "data.aasToken",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "email": {
      "type": "text",
      "label": "connected_as",
      "readOnly": true,
      "hidden": "!data.aasToken",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "_resetLogin": {
      "type": "sendTo",
      "command": "resetLogin",
      "label": "reset_button",
      "useNative": true,
      "variant": "outlined",
      "confirm": {
        "text": "reset_confirm",
        "title": "reset_confirm_title",
        "ok": "reset_confirm_ok",
        "cancel": "reset_confirm_cancel",
        "type": "warning"
      },
      "hidden": "!data.aasToken",
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "_part2Headline": {
      "type": "header",
      "text": "part2_headline",
      "size": 4,
      "hidden": "!data.aasToken || data.ownerKey",
      "newLine": true
    },
    "_part2NoRush": {
      "type": "staticText",
      "text": "part2_no_rush",
      "style": { "color": "#43a047", "fontWeight": "bold" },
      "hidden": "!data.aasToken || data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part2Intro": {
      "type": "staticText",
      "text": "part2_intro",
      "hidden": "!data.aasToken || data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part2Step1": {
      "type": "staticText",
      "text": "part2_step1",
      "hidden": "!data.aasToken || data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part2OpenUnlock": {
      "type": "sendTo",
      "command": "getStep2Url",
      "label": "part2_open_button",
      "openUrl": true,
      "variant": "contained",
      "hidden": "!data.aasToken || data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "_part2Step2": {
      "type": "staticText",
      "text": "part2_step2",
      "hidden": "!data.aasToken || data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part2Step3": {
      "type": "staticText",
      "text": "part2_step3",
      "hidden": "!data.aasToken || data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part2ShowScript": {
      "type": "sendTo",
      "command": "getStep2Script",
      "label": "part2_script_button",
      "variant": "outlined",
      "hidden": "!data.aasToken || data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "_part2Step4": {
      "type": "staticText",
      "text": "part2_step4",
      "hidden": "!data.aasToken || data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part2Image": {
      "type": "staticImage",
      "src": "img/step2-console.png",
      "showInDialog": true,
      "showInDialogSmallSize": 140,
      "hidden": "!data.aasToken || data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_part2Step5": {
      "type": "staticText",
      "text": "part2_step5",
      "hidden": "!data.aasToken || data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "sharedKeyJson": {
      "type": "text",
      "minRows": 3,
      "maxRows": 8,
      "label": "shared_key_json_label",
      "help": "shared_key_json_help",
      "hidden": "!data.aasToken || data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 8,
      "lg": 6,
      "xl": 6
    },
    "_unlockButton": {
      "type": "sendTo",
      "command": "unlockEncryption",
      "label": "unlock_button",
      "jsonData": "${JSON.stringify({ json: data.sharedKeyJson || '', email: data.email || '', aasToken: data.aasToken || '', androidId: data.androidId || '' })}",
      "useNative": true,
      "showProcess": true,
      "variant": "contained",
      "disabled": "!data.sharedKeyJson",
      "hidden": "!data.aasToken || data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "pollInterval": {
      "type": "number",
      "label": "poll_interval_label",
      "help": "poll_interval_help",
      "min": 1,
      "max": 1440,
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 3,
      "xl": 3
    },
    "_part2Done": {
      "type": "staticText",
      "text": "part2_done",
      "hidden": "!data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_deviceSettingsHeadline": {
      "type": "header",
      "text": "device_settings_headline",
      "size": 4,
      "hidden": "!data.ownerKey",
      "newLine": true
    },
    "_deviceSettingsIntro": {
      "type": "staticText",
      "text": "device_settings_intro",
      "hidden": "!data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "deviceSettings": {
      "type": "table",
      "hidden": "!data.ownerKey",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12,
      "items": [
        {
          "type": "text",
          "attr": "canonicId",
          "title": "device_id_col",
          "width": "1%",
          "hidden": true
        },
        {
          "type": "text",
          "attr": "name",
          "title": "device_name_col",
          "width": "40%",
          "readOnly": true
        },
        {
          "type": "checkbox",
          "attr": "locate",
          "title": "device_locate_col",
          "width": "25%"
        },
        {
          "type": "number",
          "attr": "intervalMinutes",
          "title": "device_interval_col",
          "width": "25%",
          "min": 5,
          "max": 1440
        }
      ]
    }
  }
}
