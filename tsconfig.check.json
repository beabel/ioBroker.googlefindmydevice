{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "allowJs": true,
        "checkJs": true,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "useUnknownInCatchVariables": false
    },
    "include": ["**/*.js", "types/**/*.d.ts"],
    "exclude": ["node_modules/**", "admin/**", ".dev-server/**", "test/**"]
}
